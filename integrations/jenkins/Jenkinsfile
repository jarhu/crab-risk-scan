// CRAB scan and gate for Jenkins.
//
// Requires the Docker Pipeline plugin and a Linux agent with Docker. The Warnings Next Generation
// plugin shows the SARIF findings; without it, remove the recordIssues step. The runner prints a
// console summary and writes the results folder, which is archived with every build.
//
// Connected mode: set CRAB_SERVER_URL and CRAB_PROJECT, and store a CRAB API token with the
// scan:upload scope as a "Secret text" credential named by CRAB_TOKEN_CREDENTIAL.

def shellQuote(String value) {
    return "'" + value.replace("'", "'\"'\"'") + "'"
}

def crabContainerArgs() {
    // Offline scans get no network. HOME points at a writable directory for the agent's uid.
    return '--entrypoint= -e HOME=/tmp' + (env.CRAB_SERVER_URL ? '' : ' --network none')
}

pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')
    }

    environment {
        CRAB_IMAGE = 'ghcr.io/jarhu/crab-risk-scan:0.3.0'
        CRAB_SCAN_PATH = '.'
        CRAB_ENGINES = 'auto'
        CRAB_RESULTS = 'crab-results'
        CRAB_POLICY = ''
        CRAB_EXCEPTIONS = ''
        CRAB_FAIL_ON = ''
        CRAB_SBOM = 'false'
        // Empty uses WORKSPACE_TMP/crab-cache. The container runs as the agent's uid, which cannot
        // write the image's cache (owned by uid 10001), so the job always brings its own cache.
        CRAB_CACHE_DIR = ''
        CRAB_SERVER_URL = ''
        CRAB_PROJECT = ''
        CRAB_TOKEN_CREDENTIAL = 'crab-token'
    }

    stages {
        stage('CRAB scan') {
            steps {
                script {
                    def args = ['ci', env.CRAB_SCAN_PATH, '--output-dir', env.CRAB_RESULTS,
                                '--engines', env.CRAB_ENGINES, '--no-fail']
                    if (env.CRAB_POLICY) { args += ['--policy', env.CRAB_POLICY] }
                    if (env.CRAB_EXCEPTIONS) { args += ['--exceptions', env.CRAB_EXCEPTIONS] }
                    if (env.CRAB_FAIL_ON) { args += ['--fail-on', env.CRAB_FAIL_ON] }
                    if (env.CRAB_SBOM == 'true') { args += ['--sbom'] }
                    def cacheDir = env.CRAB_CACHE_DIR ?: "${env.WORKSPACE_TMP}/crab-cache"
                    sh 'mkdir -p ' + shellQuote(cacheDir)
                    args += ['--cache-dir', cacheDir]
                    if (env.CRAB_SERVER_URL) { args += ['--server', env.CRAB_SERVER_URL, '--project', env.CRAB_PROJECT] }
                    def command = 'crab-risk-scan ' + args.collect { shellQuote(it) }.join(' ')
                    // A stale results folder in a persistent workspace would be scanned as plain files.
                    dir(env.CRAB_RESULTS) { deleteDir() }
                    def status = 0
                    docker.image(env.CRAB_IMAGE).inside(crabContainerArgs()) {
                        if (env.CRAB_SERVER_URL) {
                            withCredentials([string(credentialsId: env.CRAB_TOKEN_CREDENTIAL, variable: 'CRAB_TOKEN')]) {
                                status = sh(script: command, returnStatus: true)
                            }
                        } else {
                            status = sh(script: command, returnStatus: true)
                        }
                    }
                    if (!fileExists("${env.CRAB_RESULTS}/report.json")) {
                        error("CRAB did not produce a report (exit ${status}).")
                    }
                    echo "CRAB scan finished with exit status ${status}. The gate stage enforces the policy."
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "${env.CRAB_RESULTS}/**", allowEmptyArchive: true, fingerprint: true
                    recordIssues enabledForFailure: true,
                                 tools: [sarif(id: 'crab', name: 'CRAB', pattern: "${env.CRAB_RESULTS}/report.sarif")]
                }
            }
        }

        stage('CRAB gate') {
            steps {
                script {
                    def args = ['gate', "${env.CRAB_RESULTS}/report.json"]
                    if (env.CRAB_POLICY) { args += ['--policy', env.CRAB_POLICY] }
                    if (env.CRAB_EXCEPTIONS) { args += ['--exceptions', env.CRAB_EXCEPTIONS] }
                    if (env.CRAB_FAIL_ON) { args += ['--fail-on', env.CRAB_FAIL_ON] }
                    docker.image(env.CRAB_IMAGE).inside('--entrypoint= -e HOME=/tmp --network none') {
                        sh 'crab-risk-scan ' + args.collect { shellQuote(it) }.join(' ')
                    }
                }
            }
        }
    }
}
