{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jarhu/crab-risk-scan/schemas/report-v3.schema.json",
  "title": "CRAB report, schema 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "target", "revision", "branch", "repository", "files_scanned",
               "imports", "findings", "groups", "policy", "errors"],
  "properties": {
    "schema_version": {"const": 3},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"const": "crab-risk-scan"}, "version": {"type": "string", "minLength": 1}}
    },
    "target": {"type": "string", "minLength": 1, "maxLength": 256},
    "revision": {"$ref": "#/$defs/nullableIdentifier"},
    "branch": {"type": ["string", "null"], "maxLength": 256},
    "repository": {"anyOf": [{"$ref": "#/$defs/httpUri"}, {"type": "null"}]},
    "files_scanned": {"type": "integer", "minimum": 0},
    "imports": {"type": "array", "items": {"$ref": "#/$defs/import"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "inventory": {"$ref": "#/$defs/inventory"},
    "comparison": {"$ref": "#/$defs/comparison"},
    "policy": {"$ref": "#/$defs/policy"},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}
  },
  "$defs": {
    "level": {"enum": ["critical", "high", "medium", "low", "info", "unknown"]},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}(?!\\n)$"},
    "identifier": {"type": "string", "pattern": "^[\\w@.+:/~^!-]{1,256}(?!\\n)$"},
    "nullableIdentifier": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "httpUri": {"type": "string", "pattern": "^https?://[^\\s\\x00-\\x1f]{1,2040}(?!\\n)$"},
    "position": {"type": "integer", "minimum": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(?!\\n)$"},
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "producer", "origin", "status", "producer_version", "rule_pack", "targets"],
      "properties": {
        "input": {"type": "integer", "minimum": 1},
        "producer": {"$ref": "#/$defs/identifier"},
        "origin": {"enum": ["engine", "report", "manifest"]},
        "status": {"enum": ["complete", "partial", "failed", "imported", "skipped"]},
        "reason": {"$ref": "#/$defs/identifier"},
        "producer_version": {"$ref": "#/$defs/nullableIdentifier"},
        "rule_pack": {"$ref": "#/$defs/nullableIdentifier"},
        "targets": {"type": ["integer", "null"], "minimum": 0}
      },
      "allOf": [{"if": {"properties": {"status": {"enum": ["skipped", "failed"]}}}, "then": {"required": ["reason"]}}]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "version", "purl"],
      "properties": {
        "ecosystem": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/identifier"},
        "purl": {"type": ["string", "null"], "maxLength": 1100}
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "reviewer"],
      "properties": {
        "status": {"enum": ["accepted", "false_positive", "not_affected"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 256},
        "expires": {"$ref": "#/$defs/date"},
        "ticket": {"type": "string", "minLength": 1, "maxLength": 256},
        "justification": {"enum": ["code_not_present", "code_not_reachable", "requires_configuration",
                                   "requires_dependency", "requires_environment", "protected_by_compiler",
                                   "protected_at_runtime", "protected_at_perimeter",
                                   "protected_by_mitigating_control"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "producer", "producer_version", "rule_pack", "module", "category", "kind", "rule",
                   "severity", "original_severity", "message", "path", "line", "suppressed"],
      "properties": {
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "producer": {"$ref": "#/$defs/identifier"},
        "producer_version": {"$ref": "#/$defs/nullableIdentifier"},
        "rule_pack": {"$ref": "#/$defs/nullableIdentifier"},
        "module": {"enum": ["Claws", "Sniffer", "Burrow", "Shell", "Exoskeleton"]},
        "category": {"enum": ["sast", "secrets", "iac", "sca", "container"]},
        "kind": {"enum": ["vulnerability", "review"]},
        "rule": {"$ref": "#/$defs/identifier"},
        "severity": {"$ref": "#/$defs/level"},
        "original_severity": {"$ref": "#/$defs/identifier"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000},
        "path": {"type": ["string", "null"], "maxLength": 4096},
        "line": {"anyOf": [{"$ref": "#/$defs/position"}, {"type": "null"}]},
        "end_line": {"$ref": "#/$defs/position"},
        "column": {"$ref": "#/$defs/position"},
        "end_column": {"$ref": "#/$defs/position"},
        "cwe": {"type": "array", "items": {"type": "string", "pattern": "^CWE-[1-9][0-9]{0,5}(?!\\n)$"}, "uniqueItems": true},
        "help_uri": {"$ref": "#/$defs/httpUri"},
        "confidence": {"$ref": "#/$defs/identifier"},
        "resource": {"type": "string", "maxLength": 512},
        "framework": {"$ref": "#/$defs/identifier"},
        "byte_offset": {"type": "integer", "minimum": 0},
        "end_byte_offset": {"type": "integer", "minimum": 0},
        "package": {"$ref": "#/$defs/package"},
        "manifest": {"type": ["string", "null"], "maxLength": 4096},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"},
        "aliases": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "risk_type": {"enum": ["vulnerability", "malicious", "license"]},
        "fixed_version": {"$ref": "#/$defs/identifier"},
        "cvss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "vector", "source"],
          "properties": {
            "score": {"type": "number", "minimum": 0, "maximum": 10},
            "vector": {"type": ["string", "null"], "maxLength": 256},
            "source": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]}
          }
        },
        "epss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "percentile", "date"],
          "properties": {
            "score": {"type": "number", "minimum": 0, "maximum": 1},
            "percentile": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}
          }
        },
        "kev": {"const": true},
        "license": {"type": "string", "minLength": 1, "maxLength": 256},
        "inputs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "inventory_components": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "new": {"type": "boolean"},
        "suppressed": {"type": "boolean"},
        "exception": {"$ref": "#/$defs/exception"}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observations", "revision", "mapping_version", "severity"],
      "properties": {
        "id": {"$ref": "#/$defs/fingerprint"},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fingerprint"}},
        "revision": {"$ref": "#/$defs/nullableIdentifier"},
        "mapping_version": {"type": "integer", "minimum": 1},
        "severity": {"$ref": "#/$defs/level"},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "spec_version", "components"],
      "properties": {
        "format": {"const": "cyclonedx"},
        "spec_version": {"type": "string", "maxLength": 32},
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "purl", "licenses", "direct", "observations"],
            "properties": {
              "name": {"type": "string", "maxLength": 1024},
              "version": {"type": ["string", "null"], "maxLength": 256},
              "purl": {"type": ["string", "null"], "maxLength": 1100},
              "licenses": {"type": "array", "items": {"type": "string", "maxLength": 256}},
              "direct": {"type": ["boolean", "null"]},
              "observations": {"type": "array", "items": {"$ref": "#/$defs/fingerprint"}}
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_revision", "new", "unchanged", "fixed"],
      "properties": {
        "base_revision": {"$ref": "#/$defs/nullableIdentifier"},
        "new": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0},
        "fixed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fingerprint", "producer", "rule", "severity", "category", "path", "line"],
            "properties": {
              "fingerprint": {"$ref": "#/$defs/fingerprint"},
              "producer": {"$ref": "#/$defs/identifier"},
              "rule": {"$ref": "#/$defs/identifier"},
              "severity": {"$ref": "#/$defs/level"},
              "category": {"enum": ["sast", "secrets", "iac", "sca", "container"]},
              "path": {"type": ["string", "null"], "maxLength": 4096},
              "line": {"anyOf": [{"$ref": "#/$defs/position"}, {"type": "null"}]},
              "package": {"$ref": "#/$defs/package"}
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "source", "minimum_severity", "new_only", "include_review", "actionable", "suppressed",
                   "disabled_findings", "violations", "expired_exceptions", "stale_exceptions"],
      "properties": {
        "passed": {"type": "boolean"},
        "source": {"enum": ["default", "policy-file"]},
        "minimum_severity": {"anyOf": [{"$ref": "#/$defs/level"}, {"const": "none"}]},
        "new_only": {"type": "boolean"},
        "include_review": {"type": "boolean"},
        "actionable": {"type": "integer", "minimum": 0},
        "suppressed": {"type": "integer", "minimum": 0},
        "disabled_findings": {"type": "integer", "minimum": 0},
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate", "count"],
            "properties": {
              "gate": {"type": "string", "pattern": "^(severity|secrets|malicious|kev|epss|licenses|max:(critical|high|medium|low|info|unknown))(?!\\n)$"},
              "count": {"type": "integer", "minimum": 0},
              "limit": {"type": "integer", "minimum": 0}
            }
          }
        },
        "expired_exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fingerprint", "expires"],
            "properties": {"fingerprint": {"$ref": "#/$defs/fingerprint"}, "expires": {"$ref": "#/$defs/date"}}
          }
        },
        "stale_exceptions": {"type": "array", "items": {"$ref": "#/$defs/fingerprint"}}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"$ref": "#/$defs/identifier"},
        "path": {"type": "string", "maxLength": 4096},
        "input": {"type": "integer", "minimum": 1},
        "producer": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
